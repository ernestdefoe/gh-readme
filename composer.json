{
    "name": "ernestdefoe/gh-readme",
    "description": "Paste a GitHub repo URL into the Flarum composer and the URL is auto-replaced with the rendered README markdown.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "github",
        "readme",
        "composer"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ernestdefoe/gh-readme/issues",
        "source": "https://github.com/ernestdefoe/gh-readme"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "suggest": {
        "flarum/markdown": "Required for the inserted README markdown to render with headings, lists, code blocks, etc. \u2014 without it, the raw markdown still ends up in the post but renders as plain text."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\GhReadme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\GhReadme\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "GitHub README Paste",
            "category": "feature",
            "icon": {
                "name": "fab fa-github",
                "backgroundColor": "#24292f",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
